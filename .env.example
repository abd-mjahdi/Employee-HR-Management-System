POSTGRES_DB=employee_hr
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=4200

# HS256 needs at least 32 characters. Change this before any shared or production use.
JWT_SECRET=change-me-to-a-32-byte-or-longer-secret-key!!

# Empty disables POST /internal/bootstrap/company
BOOTSTRAP_KEY=

# seed = demo tenants (acme, globex). Empty = schema only.
LIQUIBASE_CONTEXTS=seed

# Empty in Docker. Use acme only when calling the API as bare localhost:8080
TENANT_DEV_DEFAULT_SLUG=
